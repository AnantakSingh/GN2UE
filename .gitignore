~$*

# Generated per-node test exports (regenerable via build_*.py)
export/*_test_a/
export/primzoo/

# Per-machine config for the dev loop (see PORTABILITY.md)
gnue.config.json

# Claude Code per-machine settings (permissions, local paths, session ids)
.claude/settings.local.json

# The live Unreal PROJECT is a separate directory and is NOT part of this repo
# (it's regenerated from the plugin zip via tools/sync_ue_plugin.py). If you
# ever nest a UE project inside, these are the folders to never commit:
Binaries/
Intermediate/
Saved/
DerivedDataCache/
*.VC.db
*.uasset.tmp

# Keep: source (.py, .cpp/.h, .md), build scripts, atlas, schema, the .blend,
# and the shipped deliverable zips. Everything above is generated or transient.

# Sea of Probabilities showcase: generated die FBX (blender/make_die.py rebuilds it)
showcase/sea_of_probabilities/build/
